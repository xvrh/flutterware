<?xml version="1.0" encoding="utf-8"?>
<!-- No <monochrome>, unlike main's. A file resource is replaced whole, so the
     themed icon main ships stops being reachable under this flavor — which the
     panel reports as a finding rather than leaving it to be found on a device. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background"/>
    <foreground android:drawable="@mipmap/ic_launcher_foreground"/>
</adaptive-icon>
