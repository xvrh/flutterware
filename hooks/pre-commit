#!/bin/bash

set -e

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

BIN=build/pre_commit
LOCKHASH=build/pre_commit.lockhash
SOURCE=tool/format_pre_commit.dart

# Hash only the pubspec.lock entries we compile against, so unrelated
# dependency bumps don't force a rebuild.
relevant_lockhash() {
  awk '
    /^  (analyzer|dart_style|path|project_tools|pub_semver):/ {p=1; print; next}
    /^  [a-z][a-z0-9_]*:[[:space:]]*$/ {p=0}
    p
  ' pubspec.lock | cksum | awk '{print $1"-"$2}'
}

# Dart from the SDK pinned in .fvmrc, not whatever is on PATH. The package's
# resolved language version (from the pinned beta SDK) can be higher than a
# globally-installed stable dart, which fails AOT compilation with "language
# version too high". Reads fvm's cache but never invokes fvm itself: fvm
# auto-installs a version it does not have, which is a multi-minute download,
# and a hook must not — resolution here is passive, and absence skips the hook
# gracefully below.
pinned_dart() {
  [ -f .fvmrc ] || return 1
  local version dart base
  version="$(sed -n 's/.*"flutter"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' .fvmrc)"
  [ -n "$version" ] || return 1
  for base in "${FVM_CACHE_PATH:-}" "${FVM_HOME:-}" "$HOME/fvm"; do
    [ -n "$base" ] || continue
    dart="$base/versions/$version/bin/dart"
    if [ -x "$dart" ]; then
      echo "$dart"
      return 0
    fi
  done
  return 1
}

CURRENT_LOCKHASH=$(relevant_lockhash)

needs_build=0
if [ ! -x "$BIN" ]; then
  needs_build=1
elif [ ! -f "$LOCKHASH" ] || [ "$(cat "$LOCKHASH")" != "$CURRENT_LOCKHASH" ]; then
  needs_build=1
elif [ "$SOURCE" -nt "$BIN" ]; then
  needs_build=1
fi

if [ "$needs_build" = 1 ]; then
  # Compiling needs resolved deps and the pinned SDK. If either is missing,
  # skip the hook gracefully rather than block the commit — CI still catches
  # formatting.
  if [ ! -f .dart_tool/package_config.json ]; then
    echo "pre-commit: deps not resolved — run 'fvm flutter pub get' to enable the format hook"
    exit 0
  fi
  if ! DART="$(pinned_dart)"; then
    echo "pre-commit: pinned Flutter SDK not found — run 'fvm install' to install it and enable the format hook"
    exit 0
  fi
  echo "pre-commit: building $BIN..."
  mkdir -p build
  if ! "$DART" compile exe "$SOURCE" -o "$BIN"; then
    echo "pre-commit: build failed — skipping the format hook; CI still checks formatting"
    exit 0
  fi
  echo "$CURRENT_LOCKHASH" > "$LOCKHASH"
fi

exec "$BIN"
